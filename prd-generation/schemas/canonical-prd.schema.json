{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilayer.local/schemas/canonical-prd.schema.json",
  "title": "Canonical PRD Artifact",
  "description": "The single machine-authoritative PRD artifact. Markdown is a deterministic view of this model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_schema_version", "run_id", "project_id", "node_id",
    "parent_node_id", "artifact_id", "artifact_type", "created_at", "generator", "status",
    "input_artifacts", "requirement_ids", "prd_status", "mode", "depth", "max_depth",
    "node_history", "requirements", "section_order", "payload"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_schema_version": {"const": "prd/v3"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": ["string", "null"]},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "prd"},
    "created_at": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR"]},
    "input_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirement_ids": {"$ref": "#/$defs/requirementIds"},
    "prd_status": {"enum": ["draft", "approved", "complete"]},
    "mode": {"enum": ["root", "derive"]},
    "depth": {"type": "integer", "minimum": 0},
    "max_depth": {"type": "integer", "minimum": 0},
    "node_history": {"type": "array"},
    "requirements": {"$ref": "#/$defs/requirementIds"},
    "section_order": {
      "const": [
        "1. Problem Statement",
        "2. Scope and Non-goals",
        "3. Current Release — Functional Requirements",
        "4. Current Release — Non-functional Requirements",
        "5. Architecture Input Contract",
        "6. Success Metrics",
        "7. Acceptance Contracts",
        "8. Oracle Coverage Ledger",
        "9. Future Backlog / Documented Exclusions",
        "10. Risks, Dependencies, and Blocking Questions",
        "11. Traceability Index",
        "12. Review Report"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "problem_statement", "scope", "requirements", "architecture_input_contract",
        "success_metrics", "acceptance_contracts", "oracle_coverage_ledger",
        "future_backlog_requirement_ids", "risks", "dependencies", "blocking_questions",
        "traceability", "review"
      ],
      "properties": {
        "document": {"$ref": "#/$defs/document"},
        "problem_statement": {"$ref": "#/$defs/problemStatement"},
        "scope": {"$ref": "#/$defs/scope"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "architecture_input_contract": {"$ref": "#/$defs/architectureInput"},
        "success_metrics": {"type": "array", "items": {"$ref": "#/$defs/successMetric"}},
        "acceptance_contracts": {"type": "array", "items": {"$ref": "#/$defs/acceptanceContract"}},
        "oracle_coverage_ledger": {"type": "array", "items": {"$ref": "#/$defs/ledgerRow"}},
        "future_backlog_requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "risks": {"type": "array"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "blocking_questions": {"type": "array", "items": {"$ref": "#/$defs/blockingQuestion"}},
        "traceability": {"type": "array", "items": {"$ref": "#/$defs/traceabilityRow"}},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "requirementIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(REQ|NFR)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"},
      "uniqueItems": true
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "title", "version", "author", "priority", "tags", "release_scope_frozen", "ready_for_test_generation", "oracle_blocked_count", "inheritance_complete", "review_method", "requirement_id_mapping"],
      "properties": {
        "doc_id": {"type": "string"}, "title": {"type": "string"}, "version": {"type": "string"},
        "author": {"type": "string"}, "priority": {"type": "string"}, "tags": {"$ref": "#/$defs/stringArray"},
        "release_scope_frozen": {"type": "boolean"}, "ready_for_test_generation": {"type": "boolean"},
        "oracle_blocked_count": {"type": "integer", "minimum": 0}, "inheritance_complete": {"type": "boolean"},
        "review_method": {"enum": ["independent_agent", "inheritance_allocation_gate"]},
        "requirement_id_mapping": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "problemStatement": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "target_users", "pain_points", "desired_outcomes", "current_alternatives", "assumptions"],
      "properties": {
        "summary": {"type": "string"}, "target_users": {"type": "string"}, "pain_points": {"type": "string"},
        "desired_outcomes": {"type": "string"}, "current_alternatives": {"$ref": "#/$defs/stringArray"},
        "assumptions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["product", "release", "current_release_boundary", "in_scope", "non_goals", "dependencies", "data_availability", "retired_requirement_ids"],
      "properties": {
        "product": {"type": "string"}, "release": {"type": "string"}, "current_release_boundary": {"type": "string"},
        "in_scope": {"$ref": "#/$defs/stringArray"}, "non_goals": {"$ref": "#/$defs/stringArray"},
        "dependencies": {"$ref": "#/$defs/stringArray"}, "data_availability": {"$ref": "#/$defs/stringArray"},
        "retired_requirement_ids": {"$ref": "#/$defs/requirementIds"}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "text", "priority", "release_scope", "scope_reason", "requirement_kind", "source_kind", "evidence_refs", "parent_requirement_id", "implementation_surfaces", "related_requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^(REQ|NFR)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"},
        "type": {"enum": ["functional", "nfr"]}, "text": {"type": "string", "minLength": 1},
        "priority": {"enum": ["Must Have", "Should Have", "Could Have", null]},
        "release_scope": {"enum": ["current", "out_of_version", "not_applicable"]},
        "scope_reason": {"$ref": "#/$defs/nullableString"}, "requirement_kind": {"enum": ["atomic", "aggregate"]},
        "source_kind": {"enum": ["explicit", "valid_derivation"]}, "evidence_refs": {"$ref": "#/$defs/stringArray"},
        "parent_requirement_id": {"$ref": "#/$defs/nullableString"}, "implementation_surfaces": {"$ref": "#/$defs/stringArray"},
        "related_requirement_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "architectureInput": {
      "type": "object", "additionalProperties": false,
      "required": ["system_boundary", "external_dependencies", "data_and_storage_constraints", "runtime_and_capacity_constraints", "security_and_privacy_constraints", "deployment_constraints", "open_decisions"],
      "properties": {
        "system_boundary": {"$ref": "#/$defs/stringArray"}, "external_dependencies": {"$ref": "#/$defs/stringArray"},
        "data_and_storage_constraints": {"$ref": "#/$defs/stringArray"}, "runtime_and_capacity_constraints": {"$ref": "#/$defs/stringArray"},
        "security_and_privacy_constraints": {"$ref": "#/$defs/stringArray"}, "deployment_constraints": {"$ref": "#/$defs/stringArray"},
        "open_decisions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "successMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "target", "measurement_method", "verifies", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^METRIC-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"},
        "name": {"type": "string"}, "target": {"type": "string"}, "measurement_method": {"type": "string"},
        "verifies": {"$ref": "#/$defs/requirementIds"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "conditionResponse": {
      "type": "object", "additionalProperties": false, "required": ["condition", "response"],
      "properties": {"condition": {"$ref": "#/$defs/nullableString"}, "response": {"$ref": "#/$defs/nullableString"}}
    },
    "acceptanceContract": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "verifies", "release_scope", "actor", "preconditions", "trigger", "response", "observable_oracles", "boundaries", "exceptions", "population", "measurement_start", "measurement_end", "unit", "threshold", "exclusions", "pass_rule", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-(REQ|NFR)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*-[0-9]{2}$"}, "type": {"enum": ["functional", "nfr"]},
        "verifies": {"$ref": "#/$defs/requirementIds"}, "release_scope": {"enum": ["current", "out_of_version", "not_applicable"]},
        "actor": {"$ref": "#/$defs/nullableString"}, "preconditions": {"$ref": "#/$defs/stringArray"},
        "trigger": {"$ref": "#/$defs/nullableString"}, "response": {"$ref": "#/$defs/stringArray"},
        "observable_oracles": {"$ref": "#/$defs/stringArray"}, "boundaries": {"type": "array", "items": {"$ref": "#/$defs/conditionResponse"}},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/conditionResponse"}},
        "population": {"$ref": "#/$defs/nullableString"}, "measurement_start": {"$ref": "#/$defs/nullableString"},
        "measurement_end": {"$ref": "#/$defs/nullableString"}, "unit": {"$ref": "#/$defs/nullableString"},
        "threshold": {"$ref": "#/$defs/nullableString"}, "exclusions": {"$ref": "#/$defs/stringArray"},
        "pass_rule": {"$ref": "#/$defs/nullableString"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "ledgerRow": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "requirement_type", "release_scope", "acceptance_contract_ids", "status", "reason"],
      "properties": {
        "requirement_id": {"type": "string"}, "requirement_type": {"enum": ["functional", "nfr"]},
        "release_scope": {"enum": ["current", "out_of_version", "not_applicable"]},
        "acceptance_contract_ids": {"$ref": "#/$defs/stringArray"}, "status": {"enum": ["ready", "blocked", "excluded"]},
        "reason": {"$ref": "#/$defs/nullableString"}
      }
    },
    "blockingQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement_id", "missing_field", "question", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q-[0-9]{3}$"}, "requirement_id": {"$ref": "#/$defs/nullableString"},
        "missing_field": {"$ref": "#/$defs/nullableString"}, "question": {"type": "string"}, "owner": {"$ref": "#/$defs/nullableString"}
      }
    },
    "traceabilityRow": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "acceptance_contract_ids", "success_metric_ids", "evidence_refs"],
      "properties": {
        "requirement_id": {"type": "string"}, "acceptance_contract_ids": {"$ref": "#/$defs/stringArray"},
        "success_metric_ids": {"$ref": "#/$defs/stringArray"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "status", "reviewer", "model", "reviewed_at", "input_hash", "findings"],
      "properties": {
        "method": {"enum": ["independent_agent", "inheritance_allocation_gate"]}, "status": {"type": "string"},
        "reviewer": {"$ref": "#/$defs/nullableString"}, "model": {"$ref": "#/$defs/nullableString"},
        "reviewed_at": {"$ref": "#/$defs/nullableString"}, "input_hash": {"$ref": "#/$defs/nullableString"},
        "findings": {"type": "array"}
      }
    }
  }
}
