FROM python:3.12-slim

WORKDIR /app
COPY shared/ ./shared/
COPY contracts/ ./contracts/
COPY worker/ ./worker/
# GAP-02：ICT-003 材料只读端口（MOD-02 所有权）经 course_app 包提供；
# worker 仅以只读方式消费（DATA_DIR 只读卷 + 只读事务）
COPY server/ ./server/
RUN pip install --no-cache-dir -r worker/requirements.txt

ENV PYTHONPATH="/app/shared:/app/worker:/app/server" \
    PYTHONUNBUFFERED=1

CMD ["python", "-m", "assessment_worker"]
