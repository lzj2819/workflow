{
  "contract_id": "CT-009",
  "title": "展示视图生成",
  "contract_type": "api",
  "direction": "sync_api",
  "provider": "MOD-05",
  "consumer": "教师浏览器",
  "endpoint": { "method": "POST", "path": "/api/v1/teacher/presentations" },
  "sync_async": "sync",
  "versioning": "/api/v1 路径版本",
  "idempotency": "相同请求参数重复生成返回最新快照，不产生重复视图记录（幂等键：教师+小组集合+时间窗）",
  "timeout_retry": "任一选定小组无可用提交 → NO_AVAILABLE_SUBMISSION 拒绝并说明原因；生成超时 → 重试",
  "error_codes": ["AUTH_INVALID", "FORBIDDEN", "VALIDATION_FAILED", "NO_AVAILABLE_SUBMISSION"],
  "publishes_events": [],
  "side_effects": "创建展示视图快照（PresentationViewGenerated，模块内快照事件）；快照不随源数据实时更新",
  "source": { "doc": "tutor/L0-root/architecture/04-interface-contracts.md", "sha256": "4599918536e46ca90f566919dc3e1e9f42c59d6da034d771ca44a98bae3efb9f" },
  "schemas": {
    "request": {
      "type": "object",
      "required": ["group_ids"],
      "properties": {
        "group_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["presentation_id", "blocks"],
      "properties": {
        "presentation_id": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group_id", "project_result", "process_summary", "grades", "annotations", "missing_marks"],
            "properties": {
              "group_id": { "type": "string" },
              "project_result": { "type": ["object", "null"], "description": "项目结果引用与摘要" },
              "process_summary": { "type": "string", "description": "过程摘要" },
              "grades": { "type": "array", "items": { "type": "object" }, "description": "评分（原始/最终）" },
              "annotations": { "type": "array", "items": { "type": "object" }, "description": "教师批注" },
              "missing_marks": { "type": "array", "items": { "type": "string", "enum": ["对话", "代码", "截图", "结果"] }, "description": "缺失标记，不隐藏缺口" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  }
}
