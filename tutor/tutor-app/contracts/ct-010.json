{
  "contract_id": "CT-010",
  "title": "模型评估推理",
  "contract_type": "external_api",
  "direction": "external_sync_api",
  "provider": "模型服务（外部）",
  "consumer": "MOD-04",
  "endpoint": { "transport": "HTTPS 模型推理 API（具体端点由供应商适配层封装）", "notes": "异步评分任务内同步调用，单次 ≤3 分钟" },
  "sync_async": "sync（在异步评分任务内调用）",
  "versioning": "供应商 API 版本由 ACL 封装，升级不影响其他 Module",
  "idempotency": "同一评分任务的重复调用以任务内结果为准，不产生重复评估记录；request_id 仅用于单次调用关联与重试去重",
  "timeout_retry": "调用超时（单次 ≤3 分钟）或解析失败 → 计入评分失败策略：自动重试一次，再失败标记 ScoringFailed（REQ-012）；ACL 校验应答 schema，非法应答视为失败",
  "error_codes": ["MODEL_TIMEOUT", "MODEL_ERROR", "INVALID_RESPONSE_SCHEMA"],
  "publishes_events": [],
  "side_effects": "产生评估结果（原始等级、依据、教师专用建议）；材料内容发送至外部供应商（数据出境，由供应商协议与 ACL 最小化控制）",
  "data_minimization": "不向外部供应商发送 submission_id、学生姓名等业务标识（KD-001 ACL 最小化）；业务关联由 MOD-04 在任务内部维护",
  "source": { "doc": "tutor/L0-root/architecture/04-interface-contracts.md", "sha256": "4599918536e46ca90f566919dc3e1e9f42c59d6da034d771ca44a98bae3efb9f" },
  "schemas": {
    "request": {
      "type": "object",
      "required": ["evaluation_prompt", "materials"],
      "properties": {
        "evaluation_prompt": { "type": "string", "minLength": 1, "description": "评估提示（≡ Gherkin 中的 assessment_prompt）" },
        "materials": {
          "type": "object",
          "description": "经 ACL 最小化编排的材料",
          "required": ["dialogue_summary", "code", "result_description"],
          "properties": {
            "dialogue_summary": { "type": "string" },
            "code": { "type": "string" },
            "result_description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "request_id": { "type": "string", "description": "请求级关联 ID，仅用于单次调用关联与重试去重；不携带 submission_id 等业务标识" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["grade", "dimension_rationales", "suggestions"],
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "dimension_rationales": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["dimension", "rationale"],
            "properties": {
              "dimension": { "type": "string", "enum": ["需求理解", "Codex 迭代过程", "代码质量", "最终功能", "文档/展示完整性"] },
              "rationale": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "suggestions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
