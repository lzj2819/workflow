{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mocktest_input.schema.json",
  "title": "Mocktest Canonical Input Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project_id", "node_id", "parent_node_id", "source_prd_id", "created_at", "generator", "status", "mode", "architecture", "testcases"],
  "properties": {
    "schema_version": {"const": "mocktest-input/v2"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": ["string", "null"]},
    "source_prd_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "generator": {"const": "mocktest"},
    "status": {"const": "PASS"},
    "mode": {"const": "strict"},
    "architecture": {"$ref": "#/$defs/architectureRef"},
    "testcases": {"$ref": "#/$defs/testcasesRef"}
  },
  "$defs": {
    "baseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "path", "schema_version", "run_id", "project_id", "node_id", "source_prd_id"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string"},
        "run_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "source_prd_id": {"type": "string", "minLength": 1}
      }
    },
    "architectureRef": {
      "allOf": [
        {"$ref": "#/$defs/baseRef"},
        {"properties": {"artifact_type": {"const": "architecture_json"}, "schema_version": {"const": "architecture/v2"}}}
      ]
    },
    "testcasesRef": {
      "allOf": [
        {"$ref": "#/$defs/baseRef"},
        {"properties": {"artifact_type": {"const": "testcases_json"}, "schema_version": {"const": "testcases/v2"}}}
      ]
    }
  }
}
