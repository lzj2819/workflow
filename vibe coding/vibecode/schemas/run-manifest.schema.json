{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "root_node_id", "input_hash", "config_hash", "identity_hash", "mode", "branch_mode", "random_seed", "is_ablation", "full_run"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "root_node_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"enum": ["full_recursive", "non_recursive", "no_mock", "no_leaf_gate"]},
    "branch_mode": {"enum": ["parallel", "sequential"]},
    "random_seed": {"type": "integer"},
    "is_ablation": {"type": "boolean"},
    "full_run": {"type": "boolean"}
  }
}
