{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-report.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "status", "lifecycle_stage", "experiment_mode", "branch_mode", "is_ablation", "full_run", "total_duration_ms", "module_durations_ms", "parallel_wall_time_ms", "sequential_time_ms", "sequential_time_label", "total_tokens", "total_cost", "model_call_count", "retry_count", "human_intervention_count", "node_count", "max_depth_reached", "continue_layering_count", "stop_layering_count", "mock_defect_count", "coding_acceptance", "contract_violation_count", "failed_stage", "final_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PENDING", "RUNNING", "PASS", "FAIL", "ERROR", "CONTINUE_LAYERING", "STOP_LAYERING", "COMPLETED"]},
    "lifecycle_stage": {"enum": ["INIT", "PRD_RUNNING", "PRD_COMPLETED", "DESIGN_AND_TEST_RUNNING", "DESIGN_AND_TEST_COMPLETED", "MOCKTEST_RUNNING", "MOCKTEST_COMPLETED", "LEAF_GATE_RUNNING", "LAYERING_CONTINUES", "LEAF_READY", "CODING_RUNNING", "CODING_COMPLETED", "BACKFILL_RUNNING", "INTEGRATION_RUNNING", "COMPLETED", "FAILED"]},
    "experiment_mode": {"type": "string"},
    "is_ablation": {"type": "boolean"},
    "full_run": {"type": "boolean"},
    "total_duration_ms": {"type": "number", "minimum": 0},
    "node_count": {"type": "integer", "minimum": 0}
  }
}
