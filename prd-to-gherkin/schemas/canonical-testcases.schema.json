{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilayer.local/schemas/canonical-testcases.schema.json",
  "title": "Canonical Testcases Artifact",
  "description": "The single machine-authoritative testcase artifact. Feature is a deterministic view.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_schema_version", "run_id", "project_id", "node_id",
    "parent_node_id", "artifact_id", "artifact_type", "created_at", "generator", "status",
    "input_artifacts", "requirement_ids", "source_prd", "render_contract", "testcases", "blocked_items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_schema_version": {"const": "testcases/v2"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": ["string", "null"]},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "testcases"},
    "created_at": {"type": "string"},
    "generator": {"const": "prd-to-gherkin"},
    "status": {"const": "PASS"},
    "input_artifacts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "requirement_ids": {"$ref": "#/$defs/requirementIds"},
    "source_prd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_schema_version", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_schema_version": {"const": "prd/v3"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "render_contract": {"$ref": "#/$defs/renderContract"},
    "testcases": {"type": "array", "items": {"$ref": "#/$defs/testcase"}, "minItems": 1},
    "blocked_items": {"const": []}
  },
  "$defs": {
    "requirementIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(REQ|NFR)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "renderContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_format_version", "encoding", "unicode_normalization", "line_ending",
        "terminal_newline", "keyword_language", "background", "scenario_outline",
        "doc_string", "data_table", "tag_order", "scenario_order"
      ],
      "properties": {
        "feature_format_version": {"const": "feature/v2"},
        "encoding": {"const": "UTF-8"},
        "unicode_normalization": {"const": "NFC"},
        "line_ending": {"const": "LF"},
        "terminal_newline": {"const": true},
        "keyword_language": {"const": "en"},
        "background": {"const": "FORBIDDEN"},
        "scenario_outline": {"const": "FORBIDDEN_IN_PRD_V3"},
        "doc_string": {"const": "FORBIDDEN"},
        "data_table": {"const": "FORBIDDEN"},
        "tag_order": {"const": ["requirement_ids", "tc_id"]},
        "scenario_order": {"const": ["acceptance_contract_id", "kind", "source_index", "tc_id"]}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "keyword", "text", "source_field", "source_index"],
      "properties": {
        "phase": {"enum": ["given", "when", "then"]},
        "keyword": {"enum": ["Given", "When", "Then", "And"]},
        "text": {"type": "string", "minLength": 1},
        "source_field": {"type": "string", "minLength": 1},
        "source_index": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "testObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_acceptance_contract_id", "source_fields", "evidence_refs"],
      "properties": {
        "kind": {"enum": ["main", "boundary", "exception", "nfr"]},
        "source_acceptance_contract_id": {"type": "string", "pattern": "^AC-(REQ|NFR)-"},
        "source_fields": {"$ref": "#/$defs/stringArray"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "testcase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tc_id", "scenario_id", "acceptance_contract_id", "requirement_ids", "source_kinds",
        "kind", "source_index", "title", "render_mode", "test_obligation", "steps", "evidence_refs"
      ],
      "properties": {
        "tc_id": {"type": "string", "pattern": "^TC-AC-(REQ|NFR)-"},
        "scenario_id": {"type": "string", "pattern": "^SC-AC-(REQ|NFR)-"},
        "acceptance_contract_id": {"type": "string", "pattern": "^AC-(REQ|NFR)-"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "source_kinds": {"type": "array", "items": {"enum": ["explicit", "valid_derivation"]}, "minItems": 1, "uniqueItems": true},
        "kind": {"enum": ["main", "boundary", "exception", "nfr"]},
        "source_index": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "render_mode": {"const": "SCENARIO"},
        "test_obligation": {"$ref": "#/$defs/testObligation"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}, "minItems": 3},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
